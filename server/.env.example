# Required: the admin password the backend page logs in with.
ANNOUNCEMENT_ADMIN_PASSWORD=change-me

# SQLite file. Its directory is created on start; back the project up by
# copying this one file.
ANNOUNCEMENT_DB=./data/announcements.db

# Optional: shared read-only token tenants must present. Leave empty to keep
# the tenant feed open (the plugin's read_token must match this value).
ANNOUNCEMENT_READ_TOKEN=

# Optional listen address (defaults 0.0.0.0:8899).
ANNOUNCEMENT_HOST=0.0.0.0
ANNOUNCEMENT_PORT=8899
